# Stage 1: Build Angular application
FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Serve application via Nginx
FROM nginx:alpine

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy Angular build output (handles both /dist/frontend and /dist/frontend/browser)
COPY --from=build /app/dist/frontend/ /usr/share/nginx/html/

# Handle Angular 17+ subfolder browser/ if present
RUN if [ -d "/usr/share/nginx/html/browser" ]; then \
      cp -r /usr/share/nginx/html/browser/* /usr/share/nginx/html/ && \
      rm -rf /usr/share/nginx/html/browser; \
    fi

EXPOSE 4200

CMD ["nginx", "-g", "daemon off;"]
