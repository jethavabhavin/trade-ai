# ==============================================================================
# TradeAI Environment Configuration Template
# ==============================================================================

# Database Configuration (MySQL 8.0)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tradeai_db

# Optional direct database connection string (overrides individual MySQL variables):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/tradeai_db

# JWT Security & Session Lifetime
JWT_SECRET_KEY=tradeai_super_secret_jwt_key_timesfm_2026_secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Key (Optional for Sentiment & Qualitative Reasoning Agents)
# If not provided, agents automatically fallback to built-in heuristic NLP engines
GEMINI_API_KEY=

# Default Seeded Credentials (Initialized via backend/schema.sql or init_db.py)
# Admin User:      username=admin       password=admin123       role=admin
# Standard Trader: username=trader_pro  password=password123    role=user
